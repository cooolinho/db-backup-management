APP_NAME="DB Backup Manager"
APP_ENV=production
# Leave empty: generated on first start and persisted to /data/app.key.
# Setting a value here overrides that and always wins.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "stderr" makes Laravel exceptions show up in `docker compose logs`, not
# just in storage/logs/laravel.log inside the container.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- The tool's own storage (users, backups, settings, audit log) ---
# Always SQLite. Set automatically to /data/database.sqlite inside the
# Docker image; only needed here for local development outside Docker.
# APP_DATABASE_PATH=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ==============================================================================
# Target database: copy this block 1:1 from the project's own .env
# ==============================================================================
DB_CONNECTION=mysql
# mysql | mariadb | pgsql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# Root/superuser credentials, used only for dump, import and the
# rename/swap between the live database and its tmp/archive copies.
# Default username: root (mysql/mariadb) or postgres (pgsql).
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=

# ==============================================================================
# Backup (defaults; each can be overridden in the UI's settings page)
# ==============================================================================
BACKUP_PATH=/backups
# Cron expression, empty = scheduler disabled
BACKUP_SCHEDULE="0 3 * * *"
# sql | sql.gz | zip | tar.gz
BACKUP_FORMAT=sql.gz
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_S3=60
BACKUP_JOB_TIMEOUT=7200

# --- S3-compatible storage (optional second copy) ---
BACKUP_S3_ENABLED=false
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=
# e.g. MinIO/Hetzner/Wasabi endpoint; leave empty for AWS S3
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_S3_PREFIX=db-backups/app

# --- UI ---
BACKUP_ADMIN_NAME="Admin"
BACKUP_ADMIN_EMAIL=admin@example.com
BACKUP_ADMIN_PASSWORD=
# Raising this past 2G also needs PHP_UPLOAD_MAX_FILE_SIZE,
# PHP_POST_MAX_SIZE and NGINX_CLIENT_MAX_BODY_SIZE (Dockerfile ENV,
# override via docker-compose.yml) raised to match.
BACKUP_UPLOAD_MAX=2G

# --- Notifications on failure only ---
BACKUP_NOTIFY_MAIL=
BACKUP_NOTIFY_WEBHOOK_URL=
# slack | discord | generic
BACKUP_NOTIFY_WEBHOOK_TYPE=slack

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="backups@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Docker (docker-compose.yml only, not read by the application itself)
# ==============================================================================
BACKUP_DOCKER_NETWORK=myproject_default
BACKUP_UI_PORT=8090
BACKUP_HOST_PATH=./backups

VITE_APP_NAME="${APP_NAME}"
