# Root-level .env for docker-compose.yml / docker-compose.dev.yml only —
# NOT read by the Laravel application itself. The app's own variables
# (DB_*, BACKUP_*, MAIL_*, ...) live in laravel/.env.example / laravel/.env.
#
# Only relevant for the docker-compose.yml variant. `docker run` needs
# none of this: pass the equivalents directly on the command line
# instead (--network, -p, -v — see docs/01-installation.md).

# Name of the target project's external Docker network (see
# docs/01-installation.md#1-netzwerkname-des-zielprojekts-ermitteln).
BACKUP_DOCKER_NETWORK=myproject_default

# Host port for the web UI.
BACKUP_UI_PORT=8090

# Host directory (or named volume) mounted to /backups.
BACKUP_HOST_PATH=./backups
